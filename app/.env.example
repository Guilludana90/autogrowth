# Modo demo: datos ficticios en el navegador, sin login real y sin ninguna llamada externa.
NEXT_PUBLIC_DEMO_MODE=true

# Supabase (solo desarrollo local hasta autorización). Con DEMO_MODE=false se usan Auth + Postgres + RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Meta Ads (P2, sandbox) · SOLO SERVIDOR: nunca con prefijo NEXT_PUBLIC_ ──
# Funciona únicamente con NEXT_PUBLIC_DEMO_MODE=false. Usar una app de Meta en modo desarrollo.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/integrations/meta/callback
# Cuentas publicitarias autorizadas explícitamente para pruebas (act_…, separadas por coma). Vacío = nada se conecta.
META_ALLOWED_AD_ACCOUNTS=
# Opcional: versión de Graph API (por defecto v23.0; verificar la vigente en developers.facebook.com).
META_GRAPH_VERSION=
# Firma del state de OAuth (mínimo 32 caracteres aleatorios).
INTEGRATION_STATE_SECRET=
# Service role de Supabase: lee/escribe tokens en integration_secrets. Nunca exponer al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# ── IA generativa (P3) · SOLO SERVIDOR ──
# Apagada por defecto. Requiere NEXT_PUBLIC_DEMO_MODE=false y una versión de prompt publicada en AI Governance.
AI_ANALYSIS_ENABLED=false
ANTHROPIC_API_KEY=
# Opcional: modelo (por defecto claude-opus-5-5) y tiempo máximo por análisis en ms (por defecto 60000).
AI_MODEL=
AI_TIMEOUT_MS=
